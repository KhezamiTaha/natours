doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    link(href='https://fonts.googleapis.com/css?family=Lato:300,300i,700', rel='stylesheet')
    link(rel='stylesheet', href='/css/style.css')
    link(rel='shortcut icon', type='image/png', href='/img/favicon.png')
    title Natours | #{title}

  body
    header.header
      nav.nav.nav--tours
        a.nav__el(href='/') All tours
        form.nav__search
          button.nav__search-btn(type='submit', aria-label='Search tours')
            svg
              use(xlink:href='/img/icons.svg#icon-search')
          input.nav__search-input(type='text', placeholder='Search tours', aria-label='Search tours')
      .header__logo
        a(href='/')
          img(src='/img/logo-white.png', alt='Natours logo')
      nav.nav.nav--user
        a.nav__el(href='#') My bookings
        a.nav__el(href='#')
          img.nav__user-img(src='/img/user.jpg', alt='User photo')
          span Jonas

    main
      section.section-header
        .header__hero
          .header__hero-overlay &nbsp;
          img.header__hero-img(src=`/img/tours/${tour.imageCover}`, alt=tour.name)
        .heading-box
          h1.heading-primary
            span= tour.name
          .heading-box__group
            .heading-box__detail
              svg.heading-box__icon
                use(xlink:href='/img/icons.svg#icon-clock')
              span.heading-box__text= `${tour.duration} days`
            .heading-box__detail
              svg.heading-box__icon
                use(xlink:href='/img/icons.svg#icon-map-pin')
              span.heading-box__text= tour.startLocation.description

      section.section-description
        .overview-box
          div
            .overview-box__group
              h2.heading-secondary.ma-bt-lg Quick facts
              .overview-box__detail
                svg.overview-box__icon
                  use(xlink:href='/img/icons.svg#icon-calendar')
                span.overview-box__label Next date
                span.overview-box__text= tour.startDates.length ? tour.startDates[0].toLocaleDateString('en-US', { month: 'long', year: 'numeric' }) : 'To be announced'
              .overview-box__detail
                svg.overview-box__icon
                  use(xlink:href='/img/icons.svg#icon-trending-up')
                span.overview-box__label Difficulty
                span.overview-box__text= tour.difficulty
              .overview-box__detail
                svg.overview-box__icon
                  use(xlink:href='/img/icons.svg#icon-user')
                span.overview-box__label Participants
                span.overview-box__text= `${tour.maxGroupSize} people`
              .overview-box__detail
                svg.overview-box__icon
                  use(xlink:href='/img/icons.svg#icon-star')
                span.overview-box__label Rating
                span.overview-box__text= `${tour.ratingsAverage} / 5`

            if tour.guides.length
              .overview-box__group
                h2.heading-secondary.ma-bt-lg Your tour guides
                each guide in tour.guides
                  .overview-box__detail
                    img.overview-box__img(src=`/img/users/${guide.photo}`, alt=guide.name)
                    span.overview-box__label= guide.role.replace('-', ' ')
                    span.overview-box__text= guide.name

        .description-box
          h2.heading-secondary.ma-bt-lg= `About ${tour.name.toLowerCase()}`
          each paragraph in tour.description.split('\n')
            if paragraph
              p.description__text= paragraph

      if tour.images.length
        section.section-pictures
          each image, index in tour.images
            .picture-box
              img.picture-box__img(class=`picture-box__img--${index + 1}`, src=`/img/tours/${image}`, alt=`${tour.name} ${index + 1}`)

      if tour.locations.length
        section.section-description
          .overview-box
            div
              .overview-box__group
                h2.heading-secondary.ma-bt-lg Itinerary
                each location in tour.locations
                  .overview-box__detail
                    svg.overview-box__icon
                      use(xlink:href='/img/icons.svg#icon-map-pin')
                    span.overview-box__label= `Day ${location.day}`
                    span.overview-box__text= location.description
          .description-box
            h2.heading-secondary.ma-bt-lg Explore Tunisia
            p.description__text= `Your ${tour.duration}-day adventure begins in ${tour.startLocation.description} and includes ${tour.locations.length} unforgettable stops.`

      if tour.reviews.length
        section.section-reviews
          .reviews
            each review in tour.reviews
              .reviews__card
                .reviews__avatar
                  img.reviews__avatar-img(src=`/img/users/${review.user.photo}`, alt=review.user.name)
                  h6.reviews__user= review.user.name
                p.reviews__text= review.review
                .reviews__rating(aria-label=`${review.rating} out of 5 stars`)
                  each star in [1, 2, 3, 4, 5]
                    svg.reviews__star(class=star <= review.rating ? 'reviews__star--active' : 'reviews__star--inactive')
                      use(xlink:href='/img/icons.svg#icon-star')

      section.section-cta
        .cta
          .cta__img.cta__img--logo
            img(src='/img/logo-white.png', alt='Natours logo')
          if tour.images[1]
            img.cta__img.cta__img--1(src=`/img/tours/${tour.images[1]}`, alt='')
          if tour.images[0]
            img.cta__img.cta__img--2(src=`/img/tours/${tour.images[0]}`, alt='')
          .cta__content
            h2.heading-secondary What are you waiting for?
            p.cta__text= `${tour.duration} days. 1 adventure. Infinite memories. Make it yours today!`
            button.btn.btn--green.span-all-rows(type='button') Book tour now!

    footer.footer
      .footer__logo
        img(src='/img/logo-green.png', alt='Natours logo')
      ul.footer__nav
        li: a(href='#') About us
        li: a(href='#') Download apps
        li: a(href='#') Become a guide
        li: a(href='#') Careers
        li: a(href='#') Contact
      p.footer__copyright &copy; by #[strong Taha Khezami]. All rights reserved.
