doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    link(href='https://fonts.googleapis.com/css?family=Lato:300,300i,700', rel='stylesheet')
    link(rel='stylesheet', href='/css/style.css')
    link(rel='shortcut icon', type='image/png', href='/img/favicon.png')
    if mapboxToken && mapLocations.length
      link(rel='stylesheet', href='https://api.mapbox.com/mapbox-gl-js/v3.30.0/mapbox-gl.css')
      script(src='https://api.mapbox.com/mapbox-gl-js/v3.30.0/mapbox-gl.js', defer)
      script(src='/js/tour-map.js', defer)
    script(src='/js/auth.js', defer)
    script(src='/js/booking.js', defer)
    title CarthageWay | #{title}

  body.tour-page
    header.header(class=currentUser && (currentUser.role === 'admin' || currentUser.role === 'lead-guide') ? 'header--admin header--admin-home' : '')
      nav.nav.nav--tours(aria-label='Main navigation')
        a.nav__el(href='/') All tours
        form.nav__search(role='search', action='/', method='GET')
          label.sr-only(for='tour-search') Search tours
          button.nav__search-btn(type='submit', aria-label='Search tours')
            svg(aria-hidden='true')
              use(xlink:href='/img/icons.svg#icon-search')
          input#tour-search.nav__search-input(type='search', name='search', placeholder='Search tours')
      a.header__logo(href='/', aria-label='CarthageWay home')
        img(src='/img/logo-white.png', alt='CarthageWay logo')
      nav.nav.nav--user(aria-label='Account navigation')
        if currentUser
          a.nav__el.nav__el--bookings(href='/my-bookings') My bookings
          if currentUser.role === 'admin' || currentUser.role === 'lead-guide'
            a.nav__el.nav__el--manage(href='/manage/tours', aria-label='Manage tours')
              svg.nav__manage-icon(aria-hidden='true')
                use(xlink:href='/img/icons.svg#icon-settings')
              span.nav__manage-label Manage tours
          details.nav-account-menu(data-account-menu)
            summary.nav-account-menu__trigger
              img.nav__user-img(src=`/img/users/${currentUser.photo}`, alt='')
              span.nav__user-name= currentUser.name.trim().split(/\s+/)[0]
              span.nav-account-menu__caret(aria-hidden='true')
            .nav-account-menu__dropdown
              a.nav-account-menu__item(href='/me') Profile
              button.nav-account-menu__item.nav-account-menu__logout(type='button', data-auth-logout) Log out
          span.sr-only(data-auth-status, role='status', aria-live='polite')
        else
          a.nav__el(href='/login') Log in
          a.nav__el.nav__el--cta(href='/signup') Sign up

    main.tour-page__main
      section.section-header#overview
        .header__hero
          .header__hero-overlay &nbsp;
          img.header__hero-img(src=`/img/tours/${tour.imageCover}`, alt=tour.name)
        .heading-box
          .heading-box__badges
            span.heading-badge.heading-badge--difficulty(class=`heading-badge--${tour.difficulty}`)= tour.difficulty
            span.heading-badge.heading-badge--rating
              svg(aria-hidden='true')
                use(xlink:href='/img/icons.svg#icon-star')
              strong= tour.ratingsAverage
              span= `(${tour.ratingsQuantity} ratings)`
          p.heading-box__eyebrow Explore Tunisia
          h1.heading-primary
            span= tour.name
          .heading-box__group
            .heading-box__detail
              svg.heading-box__icon
                use(xlink:href='/img/icons.svg#icon-clock')
              span.heading-box__text= `${tour.duration} days`
            .heading-box__detail
              svg.heading-box__icon
                use(xlink:href='/img/icons.svg#icon-map-pin')
              span.heading-box__text= tour.startLocation.description

      nav.tour-subnav(aria-label='Tour sections navigation')
        .tour-subnav__inner
          ul.tour-subnav__list
            li: a.tour-subnav__link(href='#overview') Overview
            li: a.tour-subnav__link(href='#experience') The Story
            if tour.images.length
              li: a.tour-subnav__link(href='#gallery') Photos
            if tourLocations.length
              li: a.tour-subnav__link(href='#tour-map-section') Itinerary Map
            if tour.reviews.length
              li: a.tour-subnav__link(href='#reviews') Reviews
          .tour-subnav__cta
            - const priceToDisplay = tour.priceDiscount > 0 ? tour.priceDiscount : tour.price
            span.tour-subnav__price
              if tour.priceDiscount > 0
                span.tour-subnav__strikethrough= `€${tour.price}`
              strong= `€${priceToDisplay}`
              |  / person
            a.btn.btn--green.btn--small(href='#book-tour') Book Now

      section.section-description#experience
        .overview-box
          .overview-box__content
            .overview-box__group.overview-box__group--facts
              .section-description__heading
                p.section-description__eyebrow Trip essentials
                h2.section-description__title At a glance
              .overview-box__facts
                .overview-box__detail
                  svg.overview-box__icon
                    use(xlink:href='/img/icons.svg#icon-calendar')
                  span.overview-box__label Next Departure
                  span.overview-box__text= tour.startDates.length ? tour.startDates[0].toLocaleDateString('en-US', { month: 'long', year: 'numeric' }) : 'Flexible dates'
                .overview-box__detail
                  svg.overview-box__icon
                    use(xlink:href='/img/icons.svg#icon-trending-up')
                  span.overview-box__label Difficulty
                  span.overview-box__text= tour.difficulty
                .overview-box__detail
                  svg.overview-box__icon
                    use(xlink:href='/img/icons.svg#icon-users')
                  span.overview-box__label Group Capacity
                  span.overview-box__text= `Up to ${tour.maxGroupSize} guests`
                .overview-box__detail
                  svg.overview-box__icon
                    use(xlink:href='/img/icons.svg#icon-star')
                  span.overview-box__label Guest rating
                  span.overview-box__text= `${tour.ratingsAverage} / 5 (${tour.ratingsQuantity})`

            if tour.guides.length
              .overview-box__group.overview-box__group--guides
                .section-description__heading
                  p.section-description__eyebrow Your crew
                  h2.section-description__title Meet the guides
                .overview-box__guide-list
                  each guide in tour.guides
                    .overview-box__guide
                      img.overview-box__img(src=`/img/users/${guide.photo}`, alt='')
                      .overview-box__guide-copy
                        span.overview-box__label= guide.role.replace('-', ' ')
                        strong.overview-box__text= guide.name

        .description-box
          p.section-description__eyebrow The experience
          h2.section-description__title= tour.name
          p.description__lead= tour.summary
          .description-box__content
            each paragraph in tour.description.split('\n')
              if paragraph
                p.description__text= paragraph

          .tour-highlights
            h3.tour-highlights__title Expedition Highlights
            ul.tour-highlights__list
              li
                svg.highlight-icon(aria-hidden='true')
                  use(xlink:href='/img/icons.svg#icon-check-circle')
                span Licensed expert local guides specializing in Tunisian history and nature
              li
                svg.highlight-icon(aria-hidden='true')
                  use(xlink:href='/img/icons.svg#icon-check-circle')
                span Carefully curated itinerary featuring #{tourLocations.length} stops from #{tour.startLocation.description}
              li
                svg.highlight-icon(aria-hidden='true')
                  use(xlink:href='/img/icons.svg#icon-check-circle')
                span Authentic culinary moments and immersion in regional culture
              li
                svg.highlight-icon(aria-hidden='true')
                  use(xlink:href='/img/icons.svg#icon-check-circle')
                span Small, intimate group size (maximum #{tour.maxGroupSize} travelers) for personalized discovery

      if tour.images.length
        section.section-gallery#gallery
          header.section-gallery__header
            div
              p.section-gallery__eyebrow Photo journal
              h2.section-gallery__title= `Scenes from ${tour.name}`
            span.section-gallery__count= `${tour.images.length} ${tour.images.length === 1 ? 'PHOTO' : 'PHOTOS'}`
          .section-pictures
            each image, index in tour.images
              .picture-box
                img.picture-box__img(src=`/img/tours/${image}`, alt=`${tour.name}, photo ${index + 1}`)

      if tourLocations.length
        section.section-map#tour-map-section
          .section-map__inner
            header.section-map__header
              div
                p.section-map__eyebrow Route overview
                h2.section-map__title Explore the itinerary
                p.section-map__description= mapStopCount ? `Follow ${mapStopCount} ${mapStopCount === 1 ? 'planned stop' : 'planned stops'} across ${tour.duration} days.` : `Explore the starting location for this ${tour.duration}-day tour.`
              span.section-map__count= mapStopCount ? `${mapStopCount} ${mapStopCount === 1 ? 'STOP' : 'STOPS'}` : 'START ONLY'
            .section-map__legend(aria-label='Map legend')
              if tourLocations[0] && tourLocations[0].type === 'start'
                span.section-map__legend-item
                  span.section-map__legend-marker.section-map__legend-marker--start S
                  | Start
              if mapStopCount
                span.section-map__legend-item
                  span.section-map__legend-marker.section-map__legend-marker--stop 1
                  | Stops in order
            .section-map__layout
              aside.section-map__itinerary(aria-label='Tour itinerary')
                h3.section-map__itinerary-title Route stops
                ol.section-map__stop-list
                  each location in tourLocations
                    li.section-map__stop-item
                      if mapboxToken && location.coordinatesValid
                        button.section-map__stop(type='button', data-map-location=location.mapIndex, aria-pressed='false')
                          span.section-map__stop-number(class=location.type === 'start' ? 'section-map__stop-number--start' : 'section-map__stop-number--stop')= location.type === 'start' ? 'S' : location.order
                          span.section-map__stop-copy
                            span.section-map__stop-label= location.label
                            strong.section-map__stop-name= location.description
                            if location.address
                              span.section-map__stop-address= location.address
                      else
                        .section-map__stop.section-map__stop--static
                          span.section-map__stop-number(class=location.type === 'start' ? 'section-map__stop-number--start' : 'section-map__stop-number--stop')= location.type === 'start' ? 'S' : location.order
                          span.section-map__stop-copy
                            span.section-map__stop-label= location.label
                            strong.section-map__stop-name= location.description
                            if location.address
                              span.section-map__stop-address= location.address
                            unless location.coordinatesValid
                              span.section-map__stop-address Map position unavailable
              .section-map__stage
                if mapboxToken && mapLocations.length
                  #map(
                    data-mapbox-token=mapboxToken
                    data-locations=JSON.stringify(mapLocations)
                    role='region'
                    aria-label='Interactive map of tour locations'
                  )
                  p.section-map__status(data-map-status role='status' aria-live='polite') Loading map...
                  button.section-map__fit(type='button' data-map-fit disabled) Fit all stops
                else
                  p.section-map__fallback(role='status')
                    if mapboxToken
                      | Map positions are unavailable. Use the route stops list to explore the itinerary.
                    else
                      | Interactive map is unavailable. Use the route stops list to explore the itinerary.

      if tour.reviews.length
        section.section-reviews#reviews
          header.section-reviews__header
            div
              p.section-reviews__eyebrow Notes from the road
              h2.section-reviews__title Traveler reviews
            span.section-reviews__count= `${tour.reviews.length} ${tour.reviews.length === 1 ? 'REVIEW' : 'REVIEWS'}`
          .reviews
            each review in tour.reviews
              .reviews__card
                .reviews__avatar
                  img.reviews__avatar-img(src=`/img/users/${review.user.photo}`, alt=review.user.name)
                  h6.reviews__user= review.user.name
                p.reviews__text= review.review
                .reviews__rating(aria-label=`${review.rating} out of 5 stars`)
                  each star in [1, 2, 3, 4, 5]
                    svg.reviews__star(class=star <= review.rating ? 'reviews__star--active' : 'reviews__star--inactive')
                      use(xlink:href='/img/icons.svg#icon-star')

      section.section-cta#book-tour
        .cta
          .cta__img.cta__img--logo
            img(src='/img/logo-white.png', alt='CarthageWay logo')
          if tour.images[1]
            img.cta__img.cta__img--1(src=`/img/tours/${tour.images[1]}`, alt='')
          if tour.images[0]
            img.cta__img.cta__img--2(src=`/img/tours/${tour.images[0]}`, alt='')
          .cta__content
            .cta__copy
              p.section-description__eyebrow Seamless Booking
              h2.heading-secondary Ready for adventure?
              p.cta__text= `${tour.duration} days of discovery in Tunisia. Hand-picked guides, scenic routes, and unforgettable local culture. Secure your departure today.`
              .cta__perks
                .cta__perk
                  svg.cta__perk-icon(aria-hidden='true')
                    use(xlink:href='/img/icons.svg#icon-check-circle')
                  span Free cancellation up to 48h prior
                .cta__perk
                  svg.cta__perk-icon(aria-hidden='true')
                    use(xlink:href='/img/icons.svg#icon-shield')
                  span 100% Encrypted Stripe Checkout
                .cta__perk
                  svg.cta__perk-icon(aria-hidden='true')
                    use(xlink:href='/img/icons.svg#icon-zap')
                  span Instant booking confirmation

            - const firstAvailableDeparture = bookingDepartures.find((departure) => departure.seatsRemaining > 0)
            - const bookingUnitPrice = tour.priceDiscount > 0 ? tour.priceDiscount : tour.price
            - const bookingUnitAmountCents = Math.round(bookingUnitPrice * 100)

            .booking-card
              form.booking-form(
                data-booking-form
                data-tour-id=tour._id
                data-authenticated=currentUser ? 'true' : 'false'
                data-login-url='/login'
              )
                .booking-card__header
                  .booking-card__price-box(data-unit-amount-cents=bookingUnitAmountCents)
                    if tour.priceDiscount > 0
                      .booking-card__discount-badge
                        span.booking-card__strikethrough= new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'EUR' }).format(tour.price)
                        span.booking-card__discount-pill= `Save ${new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'EUR' }).format(tour.price - tour.priceDiscount)}`
                    .booking-card__amount-row
                      span.booking-card__price= new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'EUR' }).format(bookingUnitPrice)
                      span.booking-card__unit / traveler
                  .booking-card__guarantee
                    svg.booking-card__guarantee-icon(aria-hidden='true')
                      use(xlink:href='/img/icons.svg#icon-award')
                    span Best Price Guarantee

                .booking-card__body
                  if bookingDepartures.length
                    .booking-form__group
                      label.booking-form__label(for='booking-departure')
                        svg.booking-form__label-icon(aria-hidden='true')
                          use(xlink:href='/img/icons.svg#icon-calendar')
                        span Choose Departure Date
                      .booking-form__select-wrap
                        select#booking-departure.booking-form__control(name='departureDate', data-booking-date, required)
                          each departure in bookingDepartures
                            option(
                              value=departure.date.toISOString()
                              data-seats-remaining=departure.seatsRemaining
                              disabled=departure.seatsRemaining === 0
                              selected=departure === firstAvailableDeparture
                            )= `${departure.date.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' })} — ${departure.seatsRemaining > 0 ? departure.seatsRemaining + ' seats remaining' : 'Fully booked'}`
                      .booking-form__seat-status(data-seat-pill)
                        if firstAvailableDeparture
                          span.seat-status__dot(class=firstAvailableDeparture.seatsRemaining <= 3 ? 'seat-status__dot--urgent' : '')
                          span.seat-status__text= `${firstAvailableDeparture.seatsRemaining} seats available for this date`

                    .booking-form__group
                      label.booking-form__label(for='booking-travelers')
                        svg.booking-form__label-icon(aria-hidden='true')
                          use(xlink:href='/img/icons.svg#icon-users')
                        span Number of Travelers
                      .booking-stepper
                        button.booking-stepper__btn(type='button', data-stepper-dec, aria-label='Decrease travelers') −
                        input#booking-travelers.booking-stepper__input(
                          type='number'
                          name='travelers'
                          min='1'
                          max=firstAvailableDeparture ? firstAvailableDeparture.seatsRemaining : 1
                          value='1'
                          data-booking-travelers
                          required
                          readonly
                        )
                        button.booking-stepper__btn(type='button', data-stepper-inc, aria-label='Increase travelers') +
                      p.booking-form__hint(data-traveler-hint)= `Max ${firstAvailableDeparture ? firstAvailableDeparture.seatsRemaining : 1} travelers based on available capacity`

                    .booking-breakdown
                      .booking-breakdown__row
                        span.booking-breakdown__label(data-breakdown-formula)= `${new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'EUR' }).format(bookingUnitPrice)} × 1 traveler`
                        span.booking-breakdown__val(data-breakdown-subtotal)= new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'EUR' }).format(bookingUnitPrice)
                      .booking-breakdown__row
                        span.booking-breakdown__label Booking & processing fee
                        span.booking-breakdown__val.booking-breakdown__val--free Free
                      .booking-breakdown__divider
                      .booking-breakdown__row.booking-breakdown__row--total
                        span Total due today
                        strong.booking-breakdown__total(data-booking-total)= new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'EUR' }).format(bookingUnitPrice)

                    p.form__message.booking-form__message(data-booking-message, role='status', aria-live='polite')

                    if currentUser
                      button.btn.btn--green.booking-card__submit(type='submit', data-booking-submit)
                        span.booking-card__submit-text Proceed to Checkout
                        span.booking-card__submit-arrow &rarr;
                    else
                      button.btn.btn--green.booking-card__submit(type='submit', data-booking-submit)
                        span.booking-card__submit-text Log in to Book
                        span.booking-card__submit-arrow &rarr;
                      p.booking-card__auth-note You will be returned directly here to complete your booking.

                    .booking-card__trust
                      span.booking-card__trust-item
                        svg.booking-card__trust-icon(aria-hidden='true')
                          use(xlink:href='/img/icons.svg#icon-lock')
                        | Powered by Stripe
                      span.booking-card__trust-dot •
                      span 256-bit SSL encrypted
                  else
                    .booking-card__empty
                      svg.booking-card__empty-icon(aria-hidden='true')
                        use(xlink:href='/img/icons.svg#icon-calendar')
                      p.booking-card__empty-title No Upcoming Departures
                      p.booking-card__empty-text All current departure dates have passed or are fully booked. Check back soon for new scheduled dates!

    footer.footer
      .footer__logo
        img(src='/img/logo-green.png', alt='CarthageWay logo')
      ul.footer__nav
        li: a(href='#') About us
        li: a(href='#') Download apps
        li: a(href='#') Become a guide
        li: a(href='#') Careers
        li: a(href='#') Contact
      p.footer__copyright &copy; by #[strong Taha Khezami]. All rights reserved.
