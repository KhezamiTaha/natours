doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    link(href='https://fonts.googleapis.com/css?family=Lato:300,300i,700', rel='stylesheet')
    link(rel='stylesheet', href='/css/style.css')
    link(rel='shortcut icon', type='image/png', href='/img/favicon.png')
    title CarthageWay | #{title}

  body
    header.header
      nav.nav.nav--tours
        a.nav__el(href='/') All tours
      a.header__logo(href='/', aria-label='CarthageWay home')
        img(src='/img/logo-white.png', alt='CarthageWay logo')
      nav.nav.nav--user
        a.nav__el(href='/login') Log in

    main.main
      .login-form
        h2.heading-secondary.ma-bt-lg Reset your password
        p.form__text.ma-bt-md Enter the email address on your account. If it matches an account, we will send a reset link.
        form.form(data-password-recovery='forgot')
          .form__group.ma-bt-md
            label.form__label(for='email') Email address
            input#email.form__input(type='email', name='email', placeholder='you@example.com', autocomplete='email', required)
          .form__group
            button.btn.btn--green(type='submit') Send reset link
          p.form__message(role='status', aria-live='polite')
          p.form__text
            | Remembered your password? #[a(href='/login') Log in]

    footer.footer
      .footer__logo
        img(src='/img/logo-green.png', alt='CarthageWay logo')
      p.footer__copyright &copy; by #[strong Taha Khezami]. All rights reserved.

    script(src='/js/passwordRecovery.js', defer)