doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    link(href='https://fonts.googleapis.com/css?family=Lato:300,300i,700', rel='stylesheet')
    link(rel='stylesheet', href='/css/style.css')
    link(rel='shortcut icon', type='image/png', href='/img/favicon.png')
    title CarthageWay | #{title}

  body
    header.header
      nav.nav.nav--tours
        a.nav__el(href='/') All tours
      a.header__logo(href='/', aria-label='CarthageWay home')
        img(src='/img/logo-white.png', alt='CarthageWay logo')
      nav.nav.nav--user
        a.nav__el(href='/signup') Sign up

    main.main
      .login-form
        h2.heading-secondary.ma-bt-lg Log into your account
        form.form.form--login(data-form='login')
          .form__group
            label.form__label(for='email') Email address
            input#email.form__input(type='email', name='email', placeholder='you@example.com', required)
          .form__group.ma-bt-md
            label.form__label(for='password') Password
            input#password.form__input(type='password', name='password', placeholder='••••••••', required, minlength='8')
          .form__group
            button.btn.btn--green(type='submit') Login
          p.form__message(role='status', aria-live='polite')
          p.form__text
            | Need an account? 
            a(href='/signup') Sign up

    footer.footer
      .footer__logo
        img(src='/img/logo-green.png', alt='CarthageWay logo')
      ul.footer__nav
        li: a(href='#') About us
        li: a(href='#') Download apps
        li: a(href='#') Become a guide
        li: a(href='#') Careers
        li: a(href='#') Contact
      p.footer__copyright &copy; by #[strong Taha Khezami]. All rights reserved.

    script(src='/js/auth.js', defer)
