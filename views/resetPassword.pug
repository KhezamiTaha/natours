doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    link(href='https://fonts.googleapis.com/css?family=Lato:300,300i,700', rel='stylesheet')
    link(rel='stylesheet', href='/css/style.css')
    link(rel='shortcut icon', type='image/png', href='/img/favicon.png')
    title CarthageWay | #{title}

  body
    header.header
      nav.nav.nav--tours
        a.nav__el(href='/') All tours
      a.header__logo(href='/', aria-label='CarthageWay home')
        img(src='/img/logo-white.png', alt='CarthageWay logo')
      nav.nav.nav--user
        a.nav__el(href='/login') Log in

    main.main
      .login-form
        h2.heading-secondary.ma-bt-lg Choose a new password
        p.form__text.ma-bt-md Your reset link is valid for 10 minutes and can only be used once.
        form.form(data-password-recovery='reset', data-reset-token=token)
          .form__group
            label.form__label(for='password') New password
            input#password.form__input(type='password', name='password', autocomplete='new-password', minlength='8', required)
          .form__group.ma-bt-md
            label.form__label(for='passwordConfirm') Confirm new password
            input#passwordConfirm.form__input(type='password', name='passwordConfirm', autocomplete='new-password', minlength='8', required)
          .form__group
            button.btn.btn--green(type='submit') Update password
          p.form__message(role='status', aria-live='polite')
          p.form__text
            | Need to request another link? #[a(href='/forgot-password') Reset password]

    footer.footer
      .footer__logo
        img(src='/img/logo-green.png', alt='CarthageWay logo')
      p.footer__copyright &copy; by #[strong Taha Khezami]. All rights reserved.

    script(src='/js/passwordRecovery.js', defer)