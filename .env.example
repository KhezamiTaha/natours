PASSWORD=
USERNAME_APP=
PORT=7000
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true"
NODE_ENV=development
EMAIL_PROVIDER=mailtrap
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_COOKIE_EXPIRES_IN=15m
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=100
# Public page base URL; the reset token is appended to this path.
PASSWORD_RESET_URL=http://localhost:7000/reset-password
APP_BASE_URL=http://localhost:7000
# Restricted public token for Mapbox maps and geocoding.
MAPBOX_PUBLIC_TOKEN=
# Use Stripe test-mode keys for local development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
EMAIL_FROM="CarthageWay <noreply@example.com>"